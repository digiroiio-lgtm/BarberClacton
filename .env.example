# -------------------------------------------------------
# Turkish Barber Clacton — Environment Variables Example
# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local to version control.
# -------------------------------------------------------

# Site domain (used for absolute URLs, sitemaps, canonical tags)
# NEXT_PUBLIC_SITE_URL=https://turkishbarberclacton.com

# Business phone (E.164 format, used for tel: links)
# NEXT_PUBLIC_PHONE_HREF=+441255000000

# WhatsApp number (digits only, no spaces or +)
# NEXT_PUBLIC_WHATSAPP_NUMBER=447000000000

# Google Analytics / Tag Manager ID (optional)
# NEXT_PUBLIC_GA_ID=

# Google Maps Embed API key (optional — map embed works without a key for basic usage)
# NEXT_PUBLIC_MAPS_API_KEY=

# Disable Next.js telemetry during builds (recommended for CI/CD)
# NEXT_TELEMETRY_DISABLED=1
